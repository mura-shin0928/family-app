{
  "name": "family-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:ci": "biome ci .",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
