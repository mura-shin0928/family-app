# Supabase (Settings > API で確認)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini API（レシピ本文からの材料抽出。Google AI Studio で発行）
# 本番は請求先付きのプロジェクトのキー（有料枠）を使う。docs/operations/accounts.md 参照。
# サーバー専用。NEXT_PUBLIC_ を付けない。未設定でもアプリは動く（解析機能だけ使えない）。
GEMINI_API_KEY=

# seido-data-hub API（自治体の子育て支援制度。Lambda の関数URL、末尾の / は有っても無くてもよい）
# サーバー専用。未設定でもアプリは動く（「自治体の制度を探す」と自治体の設定が画面に出なくなる）。
SEIDO_DATA_HUB_API_URL=

# Tavily API（ライフイベントの「探す」で Web からも探す。https://tavily.com で発行）
# サーバー専用。NEXT_PUBLIC_ を付けない。未設定でもアプリは動く（「Web の検索結果」が画面に出なくなる）。
TAVILY_API_KEY=

# PostHog（利用計測とエラー監視。Cloud EU のプロジェクトの API キー）
# Vercel の Production にだけ置く。ローカルとプレビューでは空のまま（何も送らない）。
NEXT_PUBLIC_POSTHOG_KEY=
