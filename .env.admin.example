# scripts/admin.mts 専用。.env.admin.local としてコピーして使う（コミットしない）。
# Supabase Dashboard > Settings > API の "service_role" key。
# このファイルの値は絶対にNEXT_PUBLIC_を付けない・アプリコードから読み込まない・Vercelに設定しない。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 招待URLの組み立てに使う（任意）。未設定でもトークンは表示される。
APP_ORIGIN=https://family-app-pi-hazel.vercel.app
